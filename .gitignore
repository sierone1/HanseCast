# Publish only the addon and reviewed public documentation.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE.txt
!/CHANGELOG.md
!/HanseCast/
!/retail/
!/tools/
/tools/*
!/tools/package_retail.py
!/tools/package_addon.py
!/tests/
/tests/*
!/tests/test_retail.py
!/tests/test_class_automation.py
!/docs/
/docs/*
!/docs/public/
# Keep local machine files and secrets out of the public repository.
**/__pycache__/
**/.env
**/.env.*
**/Thumbs.db
**/desktop.ini
